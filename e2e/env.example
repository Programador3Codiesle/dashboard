# Copiar a e2e/.env.e2e.local (ese archivo no se sube al repo).
# Las variables de entorno del sistema tienen prioridad.

E2E_ENV=local
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:4000

# Usuario de laboratorio. No usar cuentas de producción.
E2E_NIT=1095944273
E2E_PASSWORD=123456

# true solo en local/staging. Crea tickets de prueba con prefijo [E2E].
E2E_ALLOW_DESTRUCTIVE=false

# Si el frontend no está levantado: E2E_START_FRONT=1 npm run test:e2e
# E2E_START_FRONT=1
